[Unit]
Description=Accumulation Scanner — команды владельца из Telegram (/stop, /status)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/scanner
Environment=PYTHONIOENCODING=utf-8 PYTHONUTF8=1
# Один опрос getUpdates; снять стоп-кран отсюда нельзя — только `python3 run.py resume` по SSH.
ExecStart=/usr/bin/timeout 120 /usr/bin/python3 -u /opt/scanner/run.py control
TimeoutStartSec=3min
Nice=10
